<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The checked-in GitHub REST surface is intentionally generated and very large.
         Re-running Roslyn analyzers and emitting a 57 MB XML documentation file during
         every package build exhausts the standard hosted-runner envelope without adding
         validation beyond AutoSDK's generator suites. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <PackageId>tryAGI.GitHub</PackageId>
    <Description>Generated C# SDK based on the official GitHub REST OpenAPI specification.</Description>
    <PackageTags>api;client;sdk;dotnet;openapi;generated;github;rest;tryagi</PackageTags>
    <RepositoryUrl>https://github.com/HavenDV/GitHub.NET</RepositoryUrl>
  </PropertyGroup>
  
</Project>
